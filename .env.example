# Copie para .env apenas em ambientes autorizados. Nunca versione valores reais.
# Conexão do papel de runtime (sem BYPASSRLS e sem propriedade das tabelas).
DATABASE_URL=postgres://fluxora_app:troque@localhost:5432/fluxora
# Conexão do papel proprietário, usada SOMENTE para migrations.
DATABASE_URL_MIGRATOR=postgres://fluxora_owner:troque@localhost:5432/fluxora
# Autenticação (Better Auth). Segredo aleatório com 32+ caracteres (ex.: openssl rand -hex 32).
BETTER_AUTH_SECRET=
# URL pública do app (cookies, CSRF e redirecionamentos).
BETTER_AUTH_URL=https://seu-dominio
# Outras origens confiáveis, separadas por vírgula (opcional).
BETTER_AUTH_TRUSTED_ORIGINS=
# Sem DATABASE_URL o app roda apenas o modo demonstração (dados fictícios no navegador).
NEXT_PUBLIC_DEMO_MODE=1
# Integrações (desabilitadas sem credenciais; nunca simulam sucesso).
FISCAL_PROVIDER=disabled
BILLING_PROVIDER=disabled
